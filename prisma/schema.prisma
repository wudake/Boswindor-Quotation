generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
}

enum QuotationStatus {
  DRAFT
  GENERATED
  CANCELLED
}

enum ConfigCategory {
  PROFILE_SERIES
  FRAME_COLOR
  SURFACE_TREATMENT
  GLASS_SPECIFICATION
  HARDWARE_BRAND
  SCREEN_TYPE
  INSTALLATION_METHOD
  CERTIFICATION
  PRODUCT_TYPE
  CURRENCY
  TRADE_TERM
  PAYMENT_TERM
  PROJECT_TYPE
  PROJECT_STAGE
  CLIENT_TYPE
  LEAD_SOURCE
  QUOTE_VALIDITY
  OPENING_WAY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(SALES)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
  customers  Customer[]

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  companyName String?
  country     String
  city        String?
  email       String?
  whatsapp    String?
  clientType  String?
  leadSource  String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations Quotation[]

  @@map("customers")
}

model Quotation {
  id                    String          @id @default(uuid())
  quoteNo               String          @unique
  status                QuotationStatus @default(DRAFT)

  // Step 1: Client Information
  clientName            String
  companyName           String?
  country               String
  city                  String?
  clientEmail           String?
  clientWhatsapp        String?
  clientType            String?
  leadSource            String?

  // Step 2: Project Information
  projectName           String
  projectAddress        String?
  projectType           String?
  projectStage          String?
  hasDrawings           Boolean         @default(false)
  expectedPurchaseTime  String?

  // Step 3: Quotation Basic Settings
  quoteDate             DateTime        @default(now())
  quoteValidity         String?
  currency              String          @default("USD")
  tradeTerm             String          @default("EXW")
  productionLeadTime    String?
  paymentTerm           String?

  // Step 4: Specification Detail
  profileSeries         String?
  frameColor            String?
  surfaceTreatment      String?
  glassSpecification    String?
  hardwareBrand         String?
  screenType            String?
  installationMethod    String?
  certifications        String[]

  // Step 7: Price Summary
  totalArea             Decimal?        @db.Decimal(10, 4)
  productSubtotal       Decimal?        @db.Decimal(12, 2)
  accessoriesPackingFee Decimal?        @db.Decimal(12, 2)
  shippingCost          Decimal?        @db.Decimal(12, 2)
  discount              Decimal?        @db.Decimal(12, 2)
  grandTotal            Decimal?        @db.Decimal(12, 2)

  // Step 8: Terms & Notes
  termsAndConditions    String?         @db.Text
  notes                 String?         @db.Text
  tbcSummary            String?         @db.Text

  // Relations
  createdById           String
  createdBy             User            @relation(fields: [createdById], references: [id])
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  items                 QuotationItem[]
  bankAccountId         String?
  bankAccount           BankAccount?    @relation(fields: [bankAccountId], references: [id])

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(uuid())
  itemNo         Int
  windowDoorId   String?
  productType    String
  width          Int?
  height         Int?
  quantity       Int      @default(1)
  area           Decimal? @db.Decimal(10, 4)
  finalUnitPrice Decimal? @db.Decimal(12, 2)
  finalAmount    Decimal? @db.Decimal(12, 2)
  openingWay     String?
  notes          String?  @db.Text

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  images QuotationItemImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, itemNo])
  @@map("quotation_items")
}

model QuotationItemImage {
  id          String   @id @default(uuid())
  filePath    String
  description String?
  isTbc       Boolean  @default(false)
  tbcNotes    String?  @db.Text
  sortOrder   Int      @default(0)

  quotationItemId String
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotation_item_images")
}

model CompanyInfo {
  id                 String   @id @default(uuid())
  logoUrl            String?
  name               String
  address            String?
  website            String?
  phone              String?
  email              String?
  certificationsText String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_info")
}

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  swiftCode     String?
  bankAddress   String?
  notes         String?  @db.Text
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations Quotation[]

  @@map("bank_accounts")
}

model ConfigurationOption {
  id        String         @id @default(uuid())
  category  ConfigCategory
  value     String
  label     String
  labelEn   String?
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([category, value])
  @@map("configuration_options")
}

model PriceRule {
  id            String   @id @default(uuid())
  productType   String
  profileSeries String?
  baseUnitPrice Decimal  @db.Decimal(12, 2)
  minArea       Decimal? @db.Decimal(10, 4)
  maxArea       Decimal? @db.Decimal(10, 4)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("price_rules")
}
